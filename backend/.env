DATABASE_URL=postgresql://postgres:postgres@db:5432/advance

# Configuración SMTP para Gmail (usar variables de entorno en producción)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}

# Clave de encriptación AES-256 (código secreto)
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# MercadoPago (sandbox para pruebas, cambiar a producción para pagos reales)
MERCADOPAGO_ACCESS_TOKEN=${MERCADOPAGO_ACCESS_TOKEN}
MERCADOPAGO_PUBLIC_KEY=${MERCADOPAGO_PUBLIC_KEY}

# Orígenes permitidos para CORS
ALLOWED_ORIGINS=http://localhost:3000
